<%- include('../../partials/header', {title: 'Hợp đồng thuê trọ'}) %>
<h4 class="mb-3">Hợp đồng thuê trọ</h4>
<p class="text-muted">Hệ thống tự nhắc trước 1 tháng (30 ngày) khi hợp đồng sắp hết hạn — xem ở chuông thông báo hoặc bảng dưới đây (tô vàng/đỏ).</p>
<div class="card p-0">
<table class="table table-hover mb-0">
  <thead class="table-light"><tr><th>Phòng</th><th>Người thuê</th><th>Ngày bắt đầu</th><th>Ngày hết hạn</th><th>Tiền cọc</th><th>Trạng thái</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(r => { %>
    <tr class="<%= r.daysLeft !== null && r.daysLeft < 0 ? 'table-danger' : (r.daysLeft !== null && r.daysLeft <= 30 ? 'table-warning' : '') %>">
      <td>Phòng <%= r.room_name %></td>
      <td><%= r.tenants.map(t => t.full_name).join(', ') || '(chưa có ai)' %></td>
      <td><%= r.contract_start_date ? formatDate(r.contract_start_date) : '-' %></td>
      <td>
        <% if (r.contract_end_date) { %>
          <%= formatDate(r.contract_end_date) %>
          <% if (r.daysLeft < 0) { %><span class="badge bg-danger">Đã quá hạn</span>
          <% } else if (r.daysLeft <= 30) { %><span class="badge bg-warning text-dark">Còn <%= r.daysLeft %> ngày</span><% } %>
        <% } else { %><span class="text-muted">Không xác định</span><% } %>
      </td>
      <td><%= formatMoney(r.deposit_amount) %> đ</td>
      <td><span class="badge bg-success">Đang hiệu lực</span></td>
      <td>
        <a href="/nhatro/contracts/<%= r.id %>/pdf" class="btn btn-sm btn-outline-dark">PDF</a>
        <a href="/nhatro/contracts/<%= r.id %>/edit" class="btn btn-sm btn-outline-primary">Sửa</a>
        <a href="/nhatro/contracts/<%= r.id %>/renew" class="btn btn-sm btn-success">Gia hạn</a>
        <form method="POST" action="/nhatro/contracts/<%= r.id %>/terminate" class="d-inline" onsubmit="return confirm('Xác nhận chấm dứt hợp đồng Phòng <%= r.room_name %> (áp dụng cho tất cả người đang ở)?')">
          <button class="btn btn-sm btn-outline-danger">Chấm dứt</button>
        </form>
      </td>
    </tr>
  <% }) %>
  <% if (rows.length === 0) { %><tr><td colspan="7" class="text-muted text-center py-3">Chưa có hợp đồng nào. Vào "Gán/chuyển phòng" để gán người thuê và nhập thông tin hợp đồng.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../../partials/footer') %>

<%- include('../../partials/header', {title: 'Danh sách phòng trọ'}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4>Danh sách phòng trọ</h4>
  <a href="/nhatro/rooms/new" class="btn btn-primary btn-sm">+ Thêm phòng</a>
</div>
<div class="card p-0">
<table class="table table-hover mb-0">
  <thead class="table-light"><tr><th>Phòng</th><th>Giá phòng</th><th>Số người ở</th><th>Kiểu tính điện</th><th>Phí quản lý</th><th>Trạng thái</th><th></th></tr></thead>
  <tbody>
  <% rooms.forEach(r => { %>
    <tr>
      <td>Phòng <%= r.room_name %></td>
      <td><%= formatMoney(r.room_price) %> đ</td>
      <td><%= r.occupantCount %> người</td>
      <td>
        <% if (r.has_electricity_meter) { %>
          Theo đồng hồ (3.000đ/số)<% if (r.electricity_discount > 0) { %> — giảm <%= formatMoney(r.electricity_discount) %>đ<% } %>
          <% if (r.electricity_deduct_room_ids) { %><div class="text-muted small">Trừ số điện phòng khác</div><% } %>
        <% } else { %>
          Cố định <%= formatMoney(r.flat_electricity_per_person) %>đ/người (không đồng hồ)
        <% } %>
      </td>
      <td><%= r.management_fee_bundled ? 'Đã gộp vào tiền phòng' : '100.000đ/người' %></td>
      <td><% if (r.is_active) { %><span class="badge bg-success">Đang dùng</span><% } else { %><span class="badge bg-secondary">Ngừng</span><% } %></td>
      <td><a href="/nhatro/rooms/<%= r.id %>/edit" class="btn btn-sm btn-outline-primary">Sửa</a></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('../../partials/footer') %>

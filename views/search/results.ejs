<%- include('../partials/header', {title: 'Tra cứu'}) %>
<h4 class="mb-3">Kết quả tra cứu: "<%= q %>"</h4>
<div class="row g-3">
  <div class="col-md-6">
    <div class="card p-3">
      <h6>Khách hàng (<%= customers.length %>)</h6>
      <ul class="list-group list-group-flush">
        <% customers.forEach(c => { %><li class="list-group-item"><a href="/customers/<%= c.id %>"><%= c.name %></a> - <%= c.phone %></li><% }) %>
        <% if (!customers.length) { %><li class="list-group-item text-muted">Không có kết quả</li><% } %>
      </ul>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card p-3">
      <h6>Sản phẩm (<%= products.length %>)</h6>
      <ul class="list-group list-group-flush">
        <% products.forEach(p => { %><li class="list-group-item"><a href="/products/<%= p.id %>"><%= p.name %></a> - <%= p.sku %></li><% }) %>
        <% if (!products.length) { %><li class="list-group-item text-muted">Không có kết quả</li><% } %>
      </ul>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

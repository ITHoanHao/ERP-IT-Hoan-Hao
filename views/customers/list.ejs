<%- include('../partials/header', {title: 'Khách hàng'}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4>Danh sách khách hàng</h4>
  <a href="/customers/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Thêm khách hàng</a>
</div>
<form class="row g-2 mb-3" method="get">
  <div class="col-md-4">
    <input type="text" name="q" class="form-control" placeholder="Tìm theo tên/SĐT..." value="<%= q %>">
  </div>
  <div class="col-auto"><button class="btn btn-outline-secondary">Tìm</button></div>
</form>
<div class="card p-0">
<table class="table table-hover mb-0">
  <thead class="table-light"><tr><th>Tên</th><th>Loại</th><th>SĐT</th><th>Hạn mức nợ</th><th>Trạng thái</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(r => { %>
    <tr>
      <td><a href="/customers/<%= r.id %>"><%= r.name %></a></td>
      <td><%= r.customer_type %></td>
      <td><%= r.phone %></td>
      <td><%= formatMoney(r.credit_limit) %></td>
      <td><% if (r.is_active) { %><span class="badge bg-success">Hoạt động</span><% } else { %><span class="badge bg-secondary">Ngừng</span><% } %></td>
      <td><a href="/customers/<%= r.id %>/edit" class="btn btn-sm btn-outline-primary">Sửa</a></td>
    </tr>
  <% }) %>
  <% if (rows.length === 0) { %><tr><td colspan="6" class="text-muted text-center py-3">Không có khách hàng nào.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>

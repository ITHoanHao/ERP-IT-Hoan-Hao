<%- include('../partials/header', {title: title}) %>
<h4 class="mb-3"><%= title %></h4>
<div class="card p-3" style="max-width:700px">
<form method="POST" action="<%= row.id ? '/customers/' + row.id : '/customers' %>">
  <div class="row g-3">
    <div class="col-md-8">
      <label class="form-label">Tên khách hàng *</label>
      <input type="text" name="name" class="form-control" required value="<%= row.name || '' %>">
    </div>
    <div class="col-md-4">
      <label class="form-label">Loại</label>
      <select name="customer_type" class="form-select">
        <option value="Ca nhan" <%= row.customer_type === 'Ca nhan' ? 'selected' : '' %>>Cá nhân</option>
        <option value="Doanh nghiep" <%= row.customer_type === 'Doanh nghiep' ? 'selected' : '' %>>Doanh nghiệp</option>
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Số điện thoại</label>
      <input type="text" name="phone" class="form-control" value="<%= row.phone || '' %>">
    </div>
    <div class="col-md-6" id="taxCodeField">
      <label class="form-label">Mã số thuế</label>
      <input type="text" name="tax_code" class="form-control" value="<%= row.tax_code || '' %>" placeholder="Áp dụng cho khách hàng doanh nghiệp">
    </div>
    <div class="col-md-6">
      <label class="form-label">Người liên hệ</label>
      <input type="text" name="contact_person" class="form-control" value="<%= row.contact_person || '' %>">
    </div>
    <div class="col-md-6">
      <label class="form-label">Email</label>
      <input type="email" name="email" class="form-control" value="<%= row.email || '' %>">
    </div>
    <div class="col-md-6">
      <label class="form-label">Địa chỉ</label>
      <input type="text" name="address" class="form-control" value="<%= row.address || '' %>">
    </div>
    <div class="col-md-6">
      <label class="form-label">Hạn mức công nợ (đ)</label>
      <input type="number" name="credit_limit" class="form-control money-input" value="<%= row.credit_limit || 0 %>">
    </div>
    <div class="col-md-6">
      <label class="form-label">Thời hạn công nợ (ngày)</label>
      <input type="number" name="credit_term_days" class="form-control" value="<%= row.credit_term_days || settings.default_credit_term_days || 15 %>">
    </div>
    <% if (row.id) { %>
    <div class="col-md-6">
      <label class="form-label">Trạng thái</label>
      <div class="form-check form-switch mt-2">
        <input class="form-check-input" type="checkbox" name="is_active" <%= row.is_active ? 'checked' : '' %>>
        <label class="form-check-label">Đang hoạt động</label>
      </div>
    </div>
    <% } %>
  </div>

  <hr class="my-3">
  <h6 class="text-muted">Thông tin dùng khi làm Hợp đồng (không bắt buộc, chỉ cần khi có hợp đồng)</h6>
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Người đại diện</label>
      <input type="text" name="representative_name" class="form-control" value="<%= row.representative_name || '' %>" placeholder="VD: Ông Nguyễn Văn A">
    </div>
    <div class="col-md-6">
      <label class="form-label">Chức vụ</label>
      <input type="text" name="representative_position" class="form-control" value="<%= row.representative_position || '' %>" placeholder="VD: Giám đốc">
    </div>
    <div class="col-md-12">
      <label class="form-label">Số tài khoản ngân hàng</label>
      <input type="text" name="bank_account" class="form-control" value="<%= row.bank_account || '' %>" placeholder="VD: Ngân hàng Vietcombank - 0123456789 - CTY ABC">
    </div>
  </div>
  <div class="mt-3">
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a href="/customers" class="btn btn-outline-secondary">Hủy</a>
  </div>
</form>
</div>
<script>
function toggleTaxCode() {
  const type = document.querySelector('[name="customer_type"]').value;
  document.getElementById('taxCodeField').style.display = type === 'Doanh nghiep' ? '' : 'none';
}
document.querySelector('[name="customer_type"]').addEventListener('change', toggleTaxCode);
toggleTaxCode();
</script>
<%- include('../partials/footer') %>

<%- include('../partials/header', {title: row.quotation_no}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><%= row.quotation_no %>
    <% const st = {draft:['Nháp','secondary'],sent:['Đã gửi khách','info'],confirmed:['Đã chốt','success'],rejected:['Từ chối/Hết hạn','danger']}[row.status]; %>
    <span class="badge bg-<%= st[1] %>"><%= st[0] %></span>
  </h4>
  <div>
    <a href="/quotations/<%= row.id %>/pdf" class="btn btn-sm btn-outline-dark"><i class="bi bi-file-earmark-pdf"></i> Xuất PDF</a>
    <a href="/quotations/<%= row.id %>/excel" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</a>
    <% const wizardQs = (typeof wizard !== 'undefined' && wizard) ? ('?wizard=' + wizard) : ''; %>
    <% if (row.status === 'draft') { %>
      <a href="/quotations/<%= row.id %>/edit<%= wizardQs %>" class="btn btn-sm btn-outline-primary">Sửa</a>
      <form class="d-inline" method="POST" action="/quotations/<%= row.id %>/send<%= wizardQs %>"><button class="btn btn-sm btn-primary">Gửi khách hàng</button></form>
    <% } else if (row.status === 'sent') { %>
      <a href="/quotations/<%= row.id %>/edit<%= wizardQs %>" class="btn btn-sm btn-outline-primary">Sửa (tạo bản mới)</a>
      <form class="d-inline" method="POST" action="/quotations/<%= row.id %>/confirm<%= wizardQs %>"><button class="btn btn-sm btn-success">✓ Khách đã chốt</button></form>
      <form class="d-inline" method="POST" action="/quotations/<%= row.id %>/reject<%= wizardQs %>"><button class="btn btn-sm btn-outline-danger">Từ chối/Hết hạn</button></form>
    <% } %>
    <% if (typeof wizard !== 'undefined' && wizard) { %>
      <a href="/wizard/<%= wizard %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại Wizard</a>
    <% } %>
    <% if (so) { %>
      <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delChainModal">Xóa toàn bộ chuỗi liên quan</button>
    <% } else { %>
      <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delModal">Xóa</button>
    <% } %>
  </div>
</div>
<div class="card p-3 mb-3">
  <div><strong>Khách hàng:</strong> <a href="/customers/<%= row.customer_id %>"><%= row.customer_name %></a></div>
  <div><strong>Ngày báo giá:</strong> <%= formatDate(row.quotation_date) %></div>
  <% if (row.valid_until) { %><div><strong>Hiệu lực đến:</strong> <%= formatDate(row.valid_until) %></div><% } %>
  <% if (row.note) { %><div><strong>Ghi chú:</strong> <%= row.note %></div><% } %>
  <% if (so) { %><div class="mt-2"><strong>Đơn bán đã sinh:</strong> <a href="/sales-orders/<%= so.id %>"><%= so.so_no %></a></div><% } %>
</div>
<div class="card p-3">
  <h6>Chi tiết</h6>
  <table class="table table-sm">
    <thead><tr><th>Sản phẩm/Dịch vụ</th><th>SL</th><th>Đơn giá (chưa VAT)</th><th>BH</th><th>Thuế</th><th>Thành tiền (chưa VAT)</th></tr></thead>
    <tbody>
    <% lines.forEach(l => { %>
      <tr><td><%= l.product_name || l.description %></td><td><%= l.quantity %></td><td><%= formatMoney(l.unit_price) %></td><td><%= l.warranty_months %> tháng</td><td><%= l.tax_rate_percent %>%</td><td><%= formatMoney(l.line_amount) %></td></tr>
    <% }) %>
    </tbody>
    <tfoot>
      <tr><td colspan="5" class="text-end">Tạm tính (chưa VAT)</td><td><%= formatMoney(row.subtotal_amount) %></td></tr>
      <tr><td colspan="5" class="text-end">Tiền thuế VAT</td><td><%= formatMoney(row.vat_amount) %></td></tr>
      <tr class="fw-bold"><td colspan="5" class="text-end">Tổng cộng</td><td><%= formatMoney(row.total_amount) %></td></tr>
    </tfoot>
  </table>
</div>
<%- include('../partials/delete-modal', { deleteUrl: '/quotations/' + row.id + '/delete', itemLabel: 'báo giá "' + row.quotation_no + '"', modalId: 'delModal', backUrl: '/quotations' }) %>

<% if (so) { %>
<div class="modal fade" id="delChainModal" tabindex="-1">
  <div class="modal-dialog">
    <form class="modal-content" method="POST" action="/quotations/<%= row.id %>/delete-chain">
      <div class="modal-header">
        <h5 class="modal-title text-danger">Xóa toàn bộ chuỗi liên quan</h5>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning py-2 mb-3">Hành động này <strong>KHÔNG THỂ hoàn tác</strong>. Toàn bộ dữ liệu sau sẽ bị xóa cùng lúc:</div>
        <ul>
          <li>Báo giá <strong><%= row.quotation_no %></strong></li>
          <li>Đơn bán <strong><%= chainInfo.so.so_no %></strong></li>
          <% chainInfo.deliveries.forEach(d => { %><li>Phiếu giao hàng <strong><%= d.delivery_no %></strong> (tồn kho sẽ được hoàn tác tự động)</li><% }) %>
          <% if (chainInfo.invoice) { %><li>Hóa đơn <strong><%= chainInfo.invoice.invoice_no %></strong></li><% } %>
          <% if (chainInfo.payment) { %><li>Phiếu thu <strong><%= chainInfo.payment.payment_no %></strong></li><% } %>
        </ul>
        <div class="form-text mb-2">Đơn mua hàng (nếu có liên kết) sẽ KHÔNG bị xóa — vì hàng đã nhập về vẫn là dữ liệu thật, có thể dùng cho đơn hàng khác. Chỉ gỡ liên kết tham khảo.</div>
        <label class="form-label">Mật khẩu quản trị viên *</label>
        <input type="password" name="confirm_password" class="form-control" required autocomplete="off">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="submit" class="btn btn-danger">Xác nhận xóa toàn bộ chuỗi</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<div class="card p-3 mt-3">
  <h6>Tài liệu đính kèm (báo giá đã ký, scan...)</h6>
  <%- include('../partials/attachment-list', { attachments, folder: 'quotations', backUrl: '/quotations/' + row.id }) %>
  <form method="POST" action="/documents/quotation/<%= row.id %>/upload" enctype="multipart/form-data" class="row g-2">
    <input type="hidden" name="back_url" value="/quotations/<%= row.id %>">
    <div class="col-md-5">
      <input type="text" name="label" class="form-control form-control-sm" placeholder="Nhãn" value="Báo giá đã ký">
    </div>
    <div class="col-md-5">
      <input type="file" name="file" class="form-control form-control-sm" required>
    </div>
    <div class="col-md-2">
      <button type="submit" class="btn btn-sm btn-primary w-100">Tải lên</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>

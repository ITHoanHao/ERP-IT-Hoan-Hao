<%- include('../partials/header', {title: 'Tổng vụ'}) %>
<h4 class="mb-3">Tổng vụ</h4>
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card p-3 bg-primary-subtle">
      <div class="text-muted small">Nhân viên đang làm việc</div>
      <div class="fs-4 fw-bold"><%= employeeCount %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card p-3 bg-info-subtle">
      <div class="text-muted small">Tài sản đang quản lý</div>
      <div class="fs-4 fw-bold"><%= assetCount %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card p-3 bg-success-subtle">
      <div class="text-muted small">Nguyên giá tài sản</div>
      <div class="fs-5 fw-bold"><%= formatMoney(totalPurchaseCost) %> đ</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card p-3 bg-warning-subtle">
      <div class="text-muted small">Giá trị còn lại (sau khấu hao)</div>
      <div class="fs-5 fw-bold"><%= formatMoney(totalBookValue) %> đ</div>
    </div>
  </div>
</div>
<div class="d-flex gap-2">
  <a href="/tongvu/employees" class="btn btn-primary btn-sm">Danh sách nhân viên</a>
  <a href="/tongvu/assets" class="btn btn-primary btn-sm">Danh sách tài sản</a>
</div>
<%- include('../partials/footer') %>

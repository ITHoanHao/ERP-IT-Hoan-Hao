<%- include('../partials/header', {title: 'Công nợ'}) %>
<h4 class="mb-3">Công nợ phải thu</h4>
<div class="card p-3 mb-3 bg-warning-subtle">
  <div class="fw-bold">Tổng công nợ phải thu: <%= formatMoney(totalReceivable) %> đ</div>
</div>
<div class="card p-0">
<table class="table table-hover mb-0">
  <thead class="table-light"><tr><th>Số HĐ</th><th>Khách hàng</th><th>Ngày hóa đơn</th><th>Hạn thanh toán</th><th>Số tiền</th><th>Trạng thái</th></tr></thead>
  <tbody>
  <% receivable.forEach(r => { %>
    <tr class="<%= r.overdue ? 'table-danger' : '' %>">
      <td><a href="/invoices"><%= r.invoice_no %></a></td>
      <td><%= r.customer_name %></td>
      <td><%= formatDate(r.invoice_date) %></td>
      <td><%= formatDate(r.due_date) %></td>
      <td><%= formatMoney(r.total_amount) %></td>
      <td><% if (r.overdue) { %><span class="badge bg-danger">Quá hạn</span><% } else { %><span class="badge bg-secondary">Trong hạn</span><% } %></td>
    </tr>
  <% }) %>
  <% if (receivable.length === 0) { %><tr><td colspan="6" class="text-muted text-center py-3">Không có công nợ nào.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>

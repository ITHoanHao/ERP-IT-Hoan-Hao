<%- include('../partials/header', {title: 'Lợi nhuận theo đơn hàng'}) %>
<h4 class="mb-3">Lợi nhuận theo từng đơn hàng</h4>
<div class="card p-0">
<table class="table table-hover mb-0">
  <thead class="table-light"><tr><th>Số HĐ</th><th>Khách hàng</th><th>Ngày</th><th>Doanh thu</th><th>Giá vốn</th><th>Lợi nhuận</th><th>Tỷ suất</th></tr></thead>
  <tbody>
  <% rows.forEach(r => { %>
    <tr>
      <td><a href="/invoices"><%= r.invoice_no %></a></td>
      <td><%= r.customer_name %></td>
      <td><%= formatDate(r.invoice_date) %></td>
      <td><%= formatMoney(r.total_amount) %></td>
      <td><%= formatMoney(r.cogs_amount) %></td>
      <td class="fw-bold <%= r.profit_amount >= 0 ? 'text-success' : 'text-danger' %>"><%= formatMoney(r.profit_amount) %></td>
      <td><%= r.total_amount > 0 ? ((r.profit_amount / r.total_amount) * 100).toFixed(1) : 0 %>%</td>
    </tr>
  <% }) %>
  <% if (rows.length === 0) { %><tr><td colspan="7" class="text-muted text-center py-3">Chưa có dữ liệu.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header', {title: title}) %>
<% const q = state.quotation; %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="mb-0">Đơn hàng: <%= q.quotation_no %> — <%= q.customer_name %></h4>
    <div class="text-muted small"><%= q.short_title || '' %></div>
  </div>
  <a href="/wizard" class="btn btn-sm btn-outline-secondary">← Danh sách đơn đang xử lý</a>
</div>

<% if (state.completed) { %>
  <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> Đơn hàng này đã hoàn tất toàn bộ các bước. Không cần làm gì thêm.</div>
<% } %>

<div class="card">
  <ul class="list-group list-group-flush">
    <% state.steps.forEach(step => { %>
      <li class="list-group-item d-flex justify-content-between align-items-center <%= step.status === 'current' ? 'bg-primary-subtle' : '' %>">
        <div class="d-flex align-items-center gap-2">
          <% if (step.status === 'done') { %>
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
          <% } else if (step.status === 'current') { %>
            <i class="bi bi-arrow-right-circle-fill text-primary fs-5"></i>
          <% } else if (step.status === 'skipped') { %>
            <i class="bi bi-dash-circle text-secondary fs-5"></i>
          <% } else if (step.status === 'rejected') { %>
            <i class="bi bi-x-circle-fill text-danger fs-5"></i>
          <% } else { %>
            <i class="bi bi-circle text-muted fs-5"></i>
          <% } %>
          <div>
            <div class="<%= step.status === 'locked' ? 'text-muted' : '' %>"><%= step.label %></div>
            <% if (step.note) { %><div class="text-muted small fst-italic"><%= step.note %></div><% } %>
          </div>
        </div>
        <div>
          <% if (step.status === 'done') { %>
            <span class="badge bg-success">Xong</span>
          <% } else if (step.status === 'skipped') { %>
            <span class="badge bg-secondary">Bỏ qua</span>
          <% } else if (step.status === 'current' && step.link) { %>
            <a href="<%= step.link %>" class="btn btn-sm btn-primary"><%= step.actionLabel || 'Thực hiện' %> →</a>
          <% } else if (step.status === 'rejected') { %>
            <span class="badge bg-danger">Đã từ chối</span>
          <% } else { %>
            <span class="badge bg-light text-muted border">Chưa tới</span>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
</div>

<div class="mt-3 text-muted small">
  <i class="bi bi-info-circle"></i> Không thể thực hiện bước sau khi bước trước chưa hoàn tất — hệ thống sẽ tự chặn nếu cố tình bỏ qua.
</div>
<%- include('../partials/footer') %>

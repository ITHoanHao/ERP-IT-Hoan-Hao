<%- include('../partials/header', {title: 'Kho'}) %>
<h4 class="mb-3">Quản lý kho</h4>
<ul class="nav nav-tabs mb-3">
  <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabSerial">Theo Serial</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabBatch">Theo lô (số lượng)</a></li>
</ul>
<div class="tab-content">
  <div class="tab-pane fade show active" id="tabSerial">
    <div class="card p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light"><tr><th>Serial</th><th>Sản phẩm</th><th>Trạng thái</th><th>Giá nhập</th><th>HH bảo hành</th></tr></thead>
      <tbody>
      <% serials.forEach(s => { %>
        <% const st = {in_stock:['Trong kho','secondary'],sold:['Đã bán','success'],warranty:['Đang bảo hành','warning'],returned_supplier:['Đã trả NCC','dark']}[s.status] || [s.status,'secondary']; %>
        <tr><td><%= s.serial_no %></td><td><a href="/products/<%= s.product_id %>"><%= s.product_name %></a></td><td><span class="badge bg-<%= st[1] %>"><%= st[0] %></span></td><td><%= formatMoney(s.purchase_cost) %></td><td><%= s.warranty_expiry_date ? formatDate(s.warranty_expiry_date) : '-' %></td></tr>
      <% }) %>
      <% if (!serials.length) { %><tr><td colspan="5" class="text-muted text-center py-3">Chưa có dữ liệu.</td></tr><% } %>
      </tbody>
    </table>
    </div>
  </div>
  <div class="tab-pane fade" id="tabBatch">
    <div class="card p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light"><tr><th>Mã lô</th><th>Sản phẩm</th><th>Còn lại</th><th>Giá nhập</th><th>Ngày nhập</th></tr></thead>
      <tbody>
      <% batches.forEach(b => { %>
        <tr><td><%= b.batch_no %></td><td><a href="/products/<%= b.product_id %>"><%= b.product_name %></a></td><td><%= b.quantity_remaining %></td><td><%= formatMoney(b.unit_cost) %></td><td><%= formatDate(b.received_date) %></td></tr>
      <% }) %>
      <% if (!batches.length) { %><tr><td colspan="5" class="text-muted text-center py-3">Chưa có dữ liệu.</td></tr><% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
